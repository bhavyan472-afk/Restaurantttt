# Copy to .env.local (git-ignored) and fill in per deployment.

# Public: the site's canonical origin, no trailing slash. Read at build time
# for canonical, Open Graph, JSON-LD, sitemap.xml and robots.txt. Leave unset
# in development to use the https://www.example.com placeholder.
NEXT_PUBLIC_SITE_URL=

# Secrets (a mail/CRM key for the contact form, a booking provider key, an
# AI key for the concierge) go here WITHOUT the NEXT_PUBLIC_ prefix and are
# read only in server code — see lib/contactService.ts and lib/chatbot.ts.
